rules_version = '2';

// Regras de segurança do SisCautela EsFO — versão 0.3 (autocadastro com aprovação e viaturas)
// Princípio: tudo é bloqueado, exceto o que está liberado abaixo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function emailConfirmado() {
      return logado() && request.auth.token.email_verified == true;
    }
    function caminhoUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }
    function eu() {
      return get(caminhoUsuario(request.auth.uid)).data;
    }
    function ativo() {
      return emailConfirmado()
        && exists(caminhoUsuario(request.auth.uid))
        && eu().situacao == 'ativo';
    }
    function temPerfil(perfis) {
      return ativo() && eu().perfil in perfis;
    }
    function gestao() {
      return temPerfil(['gestor', 'admin']);
    }
    function souAdmin() {
      return temPerfil(['admin']);
    }

    // Dados que o próprio militar informa no cadastro.
    function dadosValidos(d) {
      return d.numero is string && d.numero.matches('^[0-9]{1,10}$')
        && d.nomeGuerra is string && d.nomeGuerra.size() >= 2 && d.nomeGuerra.size() <= 40
        && d.curso in ['CFO', 'CHOE']
        && d.turma is string && d.turma.size() >= 1 && d.turma.size() <= 40;
    }

    // ---------- usuários ----------
    match /usuarios/{uid} {
      allow get: if (logado() && uid == request.auth.uid) || temPerfil(['conferente', 'gestor', 'admin']);
      allow list: if temPerfil(['conferente', 'gestor', 'admin']);

      // Autocadastro: só o próprio militar, com e-mail confirmado,
      // sempre como "usuario" e "pendente" (aguardando aprovação).
      allow create: if emailConfirmado()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['numero', 'nomeGuerra', 'curso', 'turma', 'email', 'perfil', 'situacao', 'criadoEm'])
        && dadosValidos(request.resource.data)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.perfil == 'usuario'
        && request.resource.data.situacao == 'pendente'
        && request.resource.data.criadoEm == request.time;

      // Enquanto pendente, o próprio militar pode corrigir os seus dados.
      allow update: if logado() && uid == request.auth.uid
        && resource.data.situacao == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['numero', 'nomeGuerra', 'curso', 'turma'])
        && dadosValidos(request.resource.data);

      // Gestão: aprova, recusa, desativa, reativa e define o perfil.
      // Ninguém altera o próprio cadastro; gestor só lida com usuário/conferente; admin com todos.
      allow update: if gestao()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['situacao', 'perfil', 'decididoPor', 'decididoEm'])
        && request.resource.data.situacao in ['ativo', 'recusado', 'desativado']
        && request.resource.data.perfil in ['usuario', 'conferente', 'gestor', 'admin']
        && request.resource.data.decididoPor == request.auth.uid
        && request.resource.data.decididoEm == request.time
        && (souAdmin()
            || (resource.data.perfil in ['usuario', 'conferente']
                && request.resource.data.perfil in ['usuario', 'conferente']));

      allow delete: if false;
    }

    // ---------- viaturas ----------
    // ID do documento = "vtr-" + prefixo em minúsculas.
    function viaturaValida(d, id) {
      return d.keys().hasOnly(['prefixo', 'modelo', 'placa', 'ano', 'combustivel', 'kmAtual', 'prioridade',
                               'situacao', 'temRadio', 'usaArla', 'nova', 'atualizadoPor', 'atualizadoEm'])
        && d.prefixo is string && d.prefixo.matches('^[A-Z0-9-]{1,10}$')
        && id == 'vtr-' + d.prefixo.lower()
        && d.modelo is string && d.modelo.size() >= 2 && d.modelo.size() <= 60
        && d.placa is string && d.placa.size() <= 10
        && (d.ano == null || (d.ano is int && d.ano >= 1980 && d.ano <= 2100))
        && d.combustivel in ['flex', 'gasolina', 'diesel', 'eletrico']
        && d.kmAtual is int && d.kmAtual >= 0 && d.kmAtual <= 9999999
        && d.prioridade is int && d.prioridade >= 1 && d.prioridade <= 999
        && d.situacao in ['ativa', 'manutencao', 'baixada', 'usoExclusivo']
        && d.temRadio is bool && d.usaArla is bool && d.nova is bool
        && d.atualizadoPor == request.auth.uid
        && d.atualizadoEm == request.time;
    }

    match /viaturas/{id} {
      allow read: if ativo();
      allow create: if gestao() && viaturaValida(request.resource.data, id);
      allow update: if gestao() && viaturaValida(request.resource.data, id)
        && request.resource.data.prefixo == resource.data.prefixo;
      allow delete: if false;
    }

    // ---------- todo o resto: bloqueado ----------
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
