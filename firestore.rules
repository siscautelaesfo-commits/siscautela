rules_version = '2';

// Regras de segurança do SisCautela EsFO — versão 0.4 (cautela, devolução, avarias e abastecimentos)
// Princípio: tudo é bloqueado, exceto o que está liberado abaixo.
// A ponte do Drive (Apps Script da conta do sistema) grava com a autorização da própria conta,
// sem passar por estas regras. Os campos que só ela grava ficam bloqueados para o app.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function emailConfirmado() {
      return logado() && request.auth.token.email_verified == true;
    }
    function caminhoUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }
    function caminhoViatura(id) {
      return /databases/$(database)/documents/viaturas/$(id);
    }
    function caminhoCautela(id) {
      return /databases/$(database)/documents/cautelas/$(id);
    }
    function caminhoAvaria(id) {
      return /databases/$(database)/documents/avarias/$(id);
    }
    function eu() {
      return get(caminhoUsuario(request.auth.uid)).data;
    }
    function ativo() {
      return emailConfirmado()
        && exists(caminhoUsuario(request.auth.uid))
        && eu().situacao == 'ativo';
    }
    function temPerfil(perfis) {
      return ativo() && eu().perfil in perfis;
    }
    function gestao() {
      return temPerfil(['gestor', 'admin']);
    }
    function acompanha() {
      return temPerfil(['conferente', 'gestor', 'admin']);
    }
    function souAdmin() {
      return temPerfil(['admin']);
    }
    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function textoOuNulo(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function assinaturaValida(a) {
      return a is map && a.keys().hasOnly(['metodo', 'em'])
        && a.metodo in ['biometria', 'senha'] && a.em == request.time;
    }
    // Campos que só a ponte do Drive grava
    function camposDaPonte() {
      return ['arquivos', 'termo', 'alertaAtraso', 'fotos', 'cupom'];
    }

    // Dados que o próprio militar informa no cadastro.
    function dadosValidos(d) {
      return d.numero is string && d.numero.matches('^[0-9]{1,10}$')
        && d.nomeGuerra is string && d.nomeGuerra.size() >= 2 && d.nomeGuerra.size() <= 40
        && d.curso in ['CFO', 'CHOE', 'OFICIAL']
        // Oficial do quadro informa o posto; cadete e aluno não
        && (d.curso == 'OFICIAL' ? d.get('posto', '') in ['Asp Of', '2º Ten', '1º Ten', 'Cap', 'Maj', 'Ten Cel', 'Cel'] : !('posto' in d))
        && d.turma is string && d.turma.size() >= 1 && d.turma.size() <= 40;
    }

    // ---------- usuários ----------
    match /usuarios/{uid} {
      allow get: if (logado() && uid == request.auth.uid) || acompanha();
      allow list: if acompanha();

      // Autocadastro: só o próprio militar, com e-mail confirmado,
      // sempre como "usuario" e "pendente" (aguardando aprovação).
      allow create: if emailConfirmado()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['numero', 'nomeGuerra', 'curso', 'posto', 'turma', 'email', 'perfil', 'situacao', 'criadoEm'])
        && dadosValidos(request.resource.data)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.perfil == 'usuario'
        && request.resource.data.situacao == 'pendente'
        && request.resource.data.criadoEm == request.time;

      // Enquanto pendente, o próprio militar pode corrigir os seus dados.
      allow update: if logado() && uid == request.auth.uid
        && resource.data.situacao == 'pendente'
        && mudou().hasOnly(['numero', 'nomeGuerra', 'curso', 'posto', 'turma'])
        && dadosValidos(request.resource.data);

      // Ativo pode informar o próprio telefone (contato em caso de atraso).
      allow update: if ativo() && uid == request.auth.uid
        && mudou().hasOnly(['telefone'])
        && textoOuNulo(request.resource.data.telefone, 20);

      // Cautela em andamento: marcada ao cautelar e limpa na devolução, junto com a cautela.
      allow update: if ativo() && uid == request.auth.uid
        && mudou().hasOnly(['cautelaAtual'])
        && resource.data.get('cautelaAtual', null) == null
        && request.resource.data.cautelaAtual is string
        && getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.userId == uid
        && getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.situacao == 'aberta';
      allow update: if (ativo() && uid == request.auth.uid || gestao())
        && mudou().hasOnly(['cautelaAtual'])
        && resource.data.get('cautelaAtual', null) is string
        && request.resource.data.cautelaAtual == null
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.situacao in ['encerrada', 'cancelada'];

      // Gestão: aprova, recusa, desativa, reativa e define o perfil.
      // Ninguém altera o próprio cadastro; gestor só lida com usuário/conferente; admin com todos.
      allow update: if gestao()
        && uid != request.auth.uid
        && mudou().hasOnly(['situacao', 'perfil', 'decididoPor', 'decididoEm'])
        && request.resource.data.situacao in ['ativo', 'recusado', 'desativado']
        && request.resource.data.perfil in ['usuario', 'conferente', 'gestor', 'admin']
        && request.resource.data.decididoPor == request.auth.uid
        && request.resource.data.decididoEm == request.time
        && (request.resource.data.situacao == 'ativo' || resource.data.get('cautelaAtual', null) == null)
        && (souAdmin()
            || (resource.data.perfil in ['usuario', 'conferente']
                && request.resource.data.perfil in ['usuario', 'conferente']));

      allow delete: if false;
    }

    // ---------- viaturas ----------
    // ID do documento = "vtr-" + prefixo em minúsculas.
    function viaturaValida(d, id) {
      return d.keys().hasOnly(['prefixo', 'modelo', 'placa', 'ano', 'combustivel', 'kmAtual', 'prioridade',
                               'situacao', 'motivoSituacao', 'temRadio', 'usaArla', 'nova',
                               'cautelaAtual', 'ultimaCautela', 'combNivel', 'avariaBloqueio',
                               'atualizadoPor', 'atualizadoEm'])
        && d.prefixo is string && d.prefixo.matches('^[A-Z0-9-]{1,10}$')
        && id == 'vtr-' + d.prefixo.lower()
        && d.modelo is string && d.modelo.size() >= 2 && d.modelo.size() <= 60
        && d.placa is string && d.placa.size() <= 10
        && (d.ano == null || (d.ano is int && d.ano >= 1980 && d.ano <= 2100))
        && d.combustivel in ['flex', 'gasolina', 'diesel', 'eletrico']
        && d.kmAtual is int && d.kmAtual >= 0 && d.kmAtual <= 9999999
        && d.prioridade is int && d.prioridade >= 1 && d.prioridade <= 999
        && d.situacao in ['ativa', 'manutencao', 'baixada', 'usoExclusivo']
        && textoOuNulo(d.get('motivoSituacao', null), 200)
        && d.temRadio is bool && d.usaArla is bool && d.nova is bool
        && d.atualizadoPor == request.auth.uid
        && d.atualizadoEm == request.time;
    }

    match /viaturas/{id} {
      allow read: if ativo();
      allow create: if gestao() && viaturaValida(request.resource.data, id)
        && request.resource.data.get('cautelaAtual', null) == null;
      // A gestão edita o cadastro, mas a cautela em andamento só muda pela cautela e pela devolução.
      allow update: if gestao() && viaturaValida(request.resource.data, id)
        && request.resource.data.prefixo == resource.data.prefixo
        && request.resource.data.get('cautelaAtual', null) == resource.data.get('cautelaAtual', null)
        && (request.resource.data.situacao == 'ativa' || resource.data.get('cautelaAtual', null) == null
            || request.resource.data.situacao == resource.data.situacao);

      // Cautela: a viatura fica presa à cautela aberta. Na retirada em duas etapas, a 1ª (chave)
      // só prende a viatura; o KM e o combustível vêm na vistoria. Na antiga (uma etapa), vêm juntos.
      allow update: if ativo()
        && mudou().hasOnly(['cautelaAtual', 'kmAtual', 'combNivel', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && resource.data.situacao == 'ativa'
        && resource.data.get('cautelaAtual', null) == null
        && request.resource.data.cautelaAtual is string
        && getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.userId == request.auth.uid
        && getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.vtrId == id
        && getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.situacao == 'aberta'
        && (getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.get('etapa', null) == 'chave'
            ? mudou().hasOnly(['cautelaAtual', 'atualizadoEm'])
            : (request.resource.data.kmAtual == getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.kmSaida
               && request.resource.data.combNivel == getAfter(caminhoCautela(request.resource.data.cautelaAtual)).data.combSaida));

      // Vistoria (2ª etapa): grava o KM e o combustível da saída na viatura.
      allow update: if ativo()
        && mudou().hasOnly(['kmAtual', 'combNivel', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && resource.data.get('cautelaAtual', null) is string
        && get(caminhoCautela(resource.data.cautelaAtual)).data.get('etapa', null) == 'chave'
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.userId == request.auth.uid
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.etapa == 'em_uso'
        && request.resource.data.kmAtual == getAfter(caminhoCautela(resource.data.cautelaAtual)).data.kmSaida
        && request.resource.data.combNivel == getAfter(caminhoCautela(resource.data.cautelaAtual)).data.combSaida;

      // Cautela cancelada antes do uso (desistência ou avaria grave na vistoria): solta a viatura
      // sem mudar o KM; na avaria grave, ela sai de uso junto.
      allow update: if ativo()
        && request.resource.data.atualizadoEm == request.time
        && resource.data.get('cautelaAtual', null) is string
        && request.resource.data.cautelaAtual == null
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.situacao == 'cancelada'
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.encerradaPor == request.auth.uid
        && (mudou().hasOnly(['cautelaAtual', 'atualizadoEm'])
            || (mudou().hasOnly(['cautelaAtual', 'atualizadoEm', 'situacao', 'motivoSituacao', 'avariaBloqueio'])
                && request.resource.data.situacao == 'manutencao'
                && textoOuNulo(request.resource.data.motivoSituacao, 200)
                && request.resource.data.avariaBloqueio is string
                && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.gravidade == 'grave'
                && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.vtrId == id));

      // Devolução: solta a viatura, grava o KM e o combustível da volta e guarda a última cautela
      // (para ligar a ela uma avaria encontrada na retirada seguinte).
      allow update: if ativo()
        && mudou().hasOnly(['cautelaAtual', 'ultimaCautela', 'kmAtual', 'combNivel', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && resource.data.get('cautelaAtual', null) is string
        && request.resource.data.cautelaAtual == null
        && request.resource.data.ultimaCautela == resource.data.cautelaAtual
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.situacao == 'encerrada'
        && getAfter(caminhoCautela(resource.data.cautelaAtual)).data.encerradaPor == request.auth.uid
        && request.resource.data.kmAtual == getAfter(caminhoCautela(resource.data.cautelaAtual)).data.kmRetorno
        && request.resource.data.combNivel == getAfter(caminhoCautela(resource.data.cautelaAtual)).data.combRetorno;

      // Avaria grave encontrada pelo militar: a viatura sai de uso até a gestão liberar.
      allow update: if ativo()
        && mudou().hasOnly(['situacao', 'motivoSituacao', 'avariaBloqueio', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.situacao == 'manutencao'
        && textoOuNulo(request.resource.data.motivoSituacao, 200)
        && request.resource.data.avariaBloqueio is string
        && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.gravidade == 'grave'
        && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.vtrId == id
        && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.registradaPor == request.auth.uid
        && getAfter(caminhoAvaria(request.resource.data.avariaBloqueio)).data.em == request.time;

      allow delete: if false;
    }

    // ---------- contador das cautelas (C-0001, C-0002…) ----------
    match /contadores/{id} {
      allow read: if ativo();
      allow create: if ativo() && id == 'cautelas'
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == 1
        && existsAfter(caminhoCautela('c1'));
      allow update: if ativo() && id == 'cautelas'
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && existsAfter(caminhoCautela('c' + string(request.resource.data.ultimo)));
      allow delete: if false;
    }

    // ---------- cautelas ----------
    // ID = "c" + número sequencial; o contador e a cautela são gravados juntos (transação).
    match /cautelas/{id} {
      allow read: if ativo() && (resource.data.userId == request.auth.uid || acompanha());

      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['seq', 'numero', 'vtrId', 'vtrPrefixo', 'userId', 'userNome',
             'missao', 'justificativa', 'saida', 'previsao', 'kmSaida', 'combSaida', 'divergenciaKm',
             'assinaturaSaida', 'situacao', 'etapa'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.situacao == 'aberta'
        && request.resource.data.seq is int
        && id == 'c' + string(request.resource.data.seq)
        && request.resource.data.numero is string && request.resource.data.numero.matches('^C-[0-9]{4,}$')
        && getAfter(/databases/$(database)/documents/contadores/cautelas).data.ultimo == request.resource.data.seq
        && texto(request.resource.data.userNome, 2, 60)
        && texto(request.resource.data.missao, 3, 150)
        && textoOuNulo(request.resource.data.justificativa, 150)
        && request.resource.data.saida == request.time
        && request.resource.data.previsao is timestamp
        && request.resource.data.previsao > request.time
        && request.resource.data.previsao < request.time + duration.value(24, 'h')
        // 1ª etapa (chave): sem KM e combustível, que vêm na vistoria. Cautela antiga: tudo junto.
        && ((request.resource.data.get('etapa', null) == 'chave'
             && !('kmSaida' in request.resource.data) && !('combSaida' in request.resource.data)
             && !('divergenciaKm' in request.resource.data))
          || (!('etapa' in request.resource.data)
             && request.resource.data.kmSaida is int && request.resource.data.kmSaida >= 0 && request.resource.data.kmSaida <= 9999999
             && request.resource.data.combSaida is int && request.resource.data.combSaida >= 0 && request.resource.data.combSaida <= 4
             && (request.resource.data.divergenciaKm == null || request.resource.data.divergenciaKm is int)))
        && assinaturaValida(request.resource.data.assinaturaSaida)
        // viatura disponível, presa a esta cautela na mesma gravação
        && get(caminhoViatura(request.resource.data.vtrId)).data.situacao == 'ativa'
        && get(caminhoViatura(request.resource.data.vtrId)).data.get('cautelaAtual', null) == null
        && get(caminhoViatura(request.resource.data.vtrId)).data.prefixo == request.resource.data.vtrPrefixo
        && getAfter(caminhoViatura(request.resource.data.vtrId)).data.cautelaAtual == id
        // uma cautela aberta por militar
        && eu().get('cautelaAtual', null) == null
        && getAfter(caminhoUsuario(request.auth.uid)).data.cautelaAtual == id;

      // Vistoria (2ª etapa, na viatura): KM, combustível e hora da vistoria, pelo próprio militar.
      allow update: if ativo()
        && resource.data.situacao == 'aberta'
        && resource.data.get('etapa', null) == 'chave'
        && resource.data.userId == request.auth.uid
        && mudou().hasOnly(['etapa', 'kmSaida', 'combSaida', 'divergenciaKm', 'vistoriaEm'])
        && request.resource.data.etapa == 'em_uso'
        && request.resource.data.kmSaida is int && request.resource.data.kmSaida >= 0 && request.resource.data.kmSaida <= 9999999
        && request.resource.data.combSaida is int && request.resource.data.combSaida >= 0 && request.resource.data.combSaida <= 4
        && (request.resource.data.get('divergenciaKm', null) == null || request.resource.data.divergenciaKm is int)
        && request.resource.data.vistoriaEm == request.time
        && getAfter(caminhoViatura(resource.data.vtrId)).data.kmAtual == request.resource.data.kmSaida;

      // Cancelada antes do uso: desistência ou avaria grave na vistoria (pelo militar) ou pela gestão.
      allow update: if ativo()
        && resource.data.situacao == 'aberta'
        && resource.data.get('etapa', null) == 'chave'
        && (resource.data.userId == request.auth.uid || gestao())
        && mudou().hasOnly(['situacao', 'canceladaEm', 'motivoCancelamento', 'encerradaPor'])
        && request.resource.data.situacao == 'cancelada'
        && request.resource.data.canceladaEm == request.time
        && request.resource.data.encerradaPor == request.auth.uid
        && texto(request.resource.data.motivoCancelamento, 3, 200)
        && getAfter(caminhoViatura(resource.data.vtrId)).data.get('cautelaAtual', null) == null
        && getAfter(caminhoUsuario(resource.data.userId)).data.get('cautelaAtual', null) == null;

      // Devolução: pelo próprio militar ou, em último caso, pela gestão (fica registrado quem encerrou).
      // Só depois da vistoria (cautela em uso).
      allow update: if ativo()
        && resource.data.situacao == 'aberta'
        && resource.data.get('etapa', 'em_uso') == 'em_uso'
        && (resource.data.userId == request.auth.uid || gestao())
        && mudou().hasOnly(['situacao', 'devolucao', 'kmRetorno', 'combRetorno', 'assinaturaRetorno',
             'obs', 'justComb', 'encerradaPor'])
        && request.resource.data.situacao == 'encerrada'
        && request.resource.data.devolucao == request.time
        && request.resource.data.encerradaPor == request.auth.uid
        && request.resource.data.kmRetorno is int
        && request.resource.data.kmRetorno >= resource.data.kmSaida
        && request.resource.data.kmRetorno <= resource.data.kmSaida + 5000
        && request.resource.data.combRetorno is int && request.resource.data.combRetorno >= 0 && request.resource.data.combRetorno <= 4
        && textoOuNulo(request.resource.data.get('obs', null), 500)
        && textoOuNulo(request.resource.data.get('justComb', null), 200)
        && assinaturaValida(request.resource.data.assinaturaRetorno)
        && getAfter(caminhoViatura(resource.data.vtrId)).data.get('cautelaAtual', null) == null
        && getAfter(caminhoUsuario(resource.data.userId)).data.get('cautelaAtual', null) == null;

      allow delete: if false;
    }

    // ---------- reservas ----------
    // Reserva de viatura para uma missão futura, em blocos de 30 min (até 24 h, até 15 dias antes).
    // O que impede duas reservas no mesmo horário são os blocos: cada bloco de 30 min de cada
    // viatura é um documento único (reservaBlocos/{vtrId}_{ms}); quem chega depois não grava.
    function meiaHora(t) {
      return t is timestamp && t.toMillis() % 1800000 == 0;
    }
    function caminhoBloco(vtrId, t) {
      return /databases/$(database)/documents/reservaBlocos/$(vtrId + '_' + string(t.toMillis()));
    }
    match /reservas/{id} {
      allow read: if ativo();

      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['vtrId', 'vtrPrefixo', 'userId', 'userNome', 'missao',
             'inicio', 'fim', 'situacao', 'criadaEm'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.situacao == 'ativa'
        && request.resource.data.criadaEm == request.time
        && texto(request.resource.data.userNome, 2, 60)
        && texto(request.resource.data.missao, 3, 150)
        && meiaHora(request.resource.data.inicio) && meiaHora(request.resource.data.fim)
        && request.resource.data.inicio > request.time - duration.value(30, 'm')
        && request.resource.data.inicio < request.time + duration.value(15, 'd')
        && request.resource.data.fim > request.resource.data.inicio
        && request.resource.data.fim <= request.resource.data.inicio + duration.value(24, 'h')
        && get(caminhoViatura(request.resource.data.vtrId)).data.situacao == 'ativa'
        && get(caminhoViatura(request.resource.data.vtrId)).data.prefixo == request.resource.data.vtrPrefixo
        // o primeiro bloco é gravado junto e aponta para esta reserva
        && getAfter(caminhoBloco(request.resource.data.vtrId, request.resource.data.inicio)).data.reservaId == id;

      // Quem reservou: cancela, ou marca como cumprida ao retirar a viatura pela reserva.
      allow update: if ativo()
        && resource.data.userId == request.auth.uid
        && resource.data.situacao == 'ativa'
        && ((mudou().hasOnly(['situacao', 'canceladaPor', 'canceladaEm'])
             && request.resource.data.situacao == 'cancelada'
             && request.resource.data.canceladaPor == request.auth.uid
             && request.resource.data.canceladaEm == request.time)
          || (mudou().hasOnly(['situacao', 'cautelaId'])
             && request.resource.data.situacao == 'cumprida'
             && get(caminhoCautela(request.resource.data.cautelaId)).data.userId == request.auth.uid
             && get(caminhoCautela(request.resource.data.cautelaId)).data.vtrId == resource.data.vtrId));

      // Gestão: cancela qualquer reserva, com justificativa (missão prioritária, viatura em manutenção...).
      allow update: if gestao()
        && resource.data.situacao == 'ativa'
        && mudou().hasOnly(['situacao', 'canceladaPor', 'canceladaEm', 'motivoCancelamento'])
        && request.resource.data.situacao == 'cancelada'
        && request.resource.data.canceladaPor == request.auth.uid
        && request.resource.data.canceladaEm == request.time
        && texto(request.resource.data.motivoCancelamento, 5, 200);

      allow delete: if false;
    }

    // Bloco de 30 min: fica preso até "liberaEm" (início da reserva + 30 min de tolerância).
    // Depois disso, ou se quem reservou cancelar, o bloco pode ser usado por outra reserva.
    match /reservaBlocos/{id} {
      function blocoValido(d) {
        return d.keys().hasOnly(['vtrId', 't', 'reservaId', 'userId', 'liberaEm'])
          && d.userId == request.auth.uid
          && d.vtrId is string && d.reservaId is string
          && meiaHora(d.t)
          && id == d.vtrId + '_' + string(d.t.toMillis())
          && d.t > request.time - duration.value(30, 'm')
          && d.t < request.time + duration.value(16, 'd')
          && d.liberaEm is timestamp && d.liberaEm <= d.t + duration.value(24, 'h');
      }
      allow read: if emailConfirmado();
      allow create: if emailConfirmado() && blocoValido(request.resource.data);
      allow update: if emailConfirmado()
        && ((resource.data.liberaEm < request.time && blocoValido(request.resource.data))
          || (resource.data.userId == request.auth.uid
              && mudou().hasOnly(['liberaEm'])
              && request.resource.data.liberaEm == request.time));
      allow delete: if false;
    }

    // ---------- avarias ----------
    match /avarias/{id} {
      allow read: if ativo() && (resource.data.registradaPor == request.auth.uid || acompanha());
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['vtrId', 'vtrPrefixo', 'cautelaId', 'origemProvavel',
             'descricao', 'gravidade', 'situacao', 'registradaPor', 'registradaNome', 'em'])
        && request.resource.data.registradaPor == request.auth.uid
        && texto(request.resource.data.registradaNome, 2, 60)
        && request.resource.data.em == request.time
        && request.resource.data.situacao == 'aberta'
        && request.resource.data.gravidade in ['leve', 'grave']
        && texto(request.resource.data.descricao, 5, 500)
        && exists(caminhoViatura(request.resource.data.vtrId))
        && get(caminhoViatura(request.resource.data.vtrId)).data.prefixo == request.resource.data.vtrPrefixo
        && (request.resource.data.cautelaId == null
            || getAfter(caminhoCautela(request.resource.data.cautelaId)).data.userId == request.auth.uid)
        && (request.resource.data.origemProvavel == null || request.resource.data.origemProvavel is string);
      allow update: if gestao()
        && mudou().hasOnly(['situacao', 'tratadaPor', 'tratadaEm'])
        && request.resource.data.situacao in ['aberta', 'apuracao', 'resolvida']
        && request.resource.data.tratadaPor == request.auth.uid
        && request.resource.data.tratadaEm == request.time;
      allow delete: if false;
    }

    // ---------- abastecimentos ----------
    match /abastecimentos/{id} {
      allow read: if ativo() && (resource.data.userId == request.auth.uid || acompanha());
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['cautelaId', 'vtrId', 'vtrPrefixo', 'userId', 'userNome', 'em', 'km',
             'litros', 'valor', 'posto'])
        && texto(request.resource.data.userNome, 2, 60)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.em == request.time
        && getAfter(caminhoCautela(request.resource.data.cautelaId)).data.userId == request.auth.uid
        && getAfter(caminhoCautela(request.resource.data.cautelaId)).data.vtrId == request.resource.data.vtrId
        && request.resource.data.litros is number && request.resource.data.litros > 0 && request.resource.data.litros <= 200
        && request.resource.data.valor is number && request.resource.data.valor >= 0 && request.resource.data.valor <= 5000
        && request.resource.data.km is int && request.resource.data.km >= 0
        && textoOuNulo(request.resource.data.posto, 80)
        && texto(request.resource.data.vtrPrefixo, 1, 10);
      allow update, delete: if false;
    }

    // ---------- trilha de auditoria (gravada pela ponte) ----------
    match /log/{id} {
      allow read: if gestao();
      allow write: if false;
    }

    // ---------- todo o resto: bloqueado ----------
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
